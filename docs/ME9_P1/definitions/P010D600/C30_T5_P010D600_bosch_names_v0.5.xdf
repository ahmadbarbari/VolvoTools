<!-- Written by Claude, 2026-11-14; v0.5 2026-11-18. Ported map names; see each description for what is confirmed. -->
<XDFFORMAT version="1.70">
  <XDFHEADER>
    <flags>0x1</flags>
    <fileversion>0.5.1</fileversion>
    <deftitle>Volvo C30 T5 ME9.0C P010D600 (0261209038) - Bosch names v0.5</deftitle>
    <description>v0.5.1 (2026-11-18 late): Bosch names KFPNDSOL, FRLFSDP, KRKATE, PNDMIN, PNDMAX from the Ford A2L. v0.5 (2026-11-18): fuel pressure target map, injector constant, fuel-pressure correction curve and fuel-pressure limits added (code-traced, fuel pressure map and injector constant confirmed by logs); KFDZWKG + DZWOLA confirmed as the rich-mixture ignition advance; cam target maps KFNWSE/KFNWSA traced in code (log check pending); exhaust cam maps now signed. Flash test done 2026-11-15, the file can be edited. Older text: v0.4 (2026-11-15): adds KFTATM, 7 fault-code class entries and CWLSHA; 23 maps confirmed by a purchased stage 2 file. 730 maps and curves with Bosch names, ported to a P010D600 stock read from (1) a WinOLS map pack for Volvo ME9.0C 0261209009 / P010BB00 and (2) the Ford Focus RS ME9.0C A2L P050F100, by matching the code that reads each map and the axis header bytes. Most scalars are in the CSV; v0.5 adds a few confirmed ones as constants.</description>
    <author>ahmadbarbari and Claude (Anthropic)</author>
    <BASEOFFSET offset="0" subtract="0" />
    <DEFAULTS datasizeinbits="8" sigdigits="2" outputtype="1" signed="0" lsbfirst="0" float="0" />
    <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x200000" regionflags="0x0" name="Binary File" desc="2 MB ME9 P1 full read" />
    <CATEGORY index="0x0" name="Boost control (LDR)" />
    <CATEGORY index="0x1" name="Torque / load" />
    <CATEGORY index="0x2" name="Ignition" />
    <CATEGORY index="0x3" name="Lambda / fuel" />
    <CATEGORY index="0x4" name="Rev limit" />
    <CATEGORY index="0x5" name="Camshaft (VVT)" />
    <CATEGORY index="0x6" name="Function monitoring (_UM)" />
    <CATEGORY index="0x7" name="Other" />
    <CATEGORY index="0x8" name="Fault codes (DTC)" />
  </XDFHEADER>
